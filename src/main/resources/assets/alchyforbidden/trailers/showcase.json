  "texts": [
    {
      "at": 30,
      "ticks": 130,
      "text": "In the depths of the abyss, where I was left for dead...",
      "style": "caption"
    },
    {
      "at": 205,
      "ticks": 120,
      "text": "...something was waiting under the dead portal.",
      "style": "caption"
    },
    {
      "at": 580,
      "ticks": 120,
      "text": "I gave. The rift grew the rest.",
      "style": "caption"
    },
    {
      "at": 850,
      "ticks": 120,
      "text": "Down here, every grief has a use.",
      "style": "caption"
    },
    {
      "at": 1190,
      "ticks": 120,
      "text": "Wrath, wrung from what suffers.",
      "style": "caption"
    },
    {
      "at": 1530,
      "ticks": 120,
      "text": "Sorrow, wept by the stone itself.",
      "style": "caption"
    },
    {
      "at": 1850,
      "ticks": 110,
      "text": "I bound their hunger into rings.",
      "style": "caption"
    },
    {
      "at": 2140,
      "ticks": 110,
      "text": "Then I carved it into myself.",
      "style": "caption"
    },
    {
      "at": 2430,
      "ticks": 120,
      "text": "But the rift wanted more than grief.",
      "style": "caption"
    },
    {
      "at": 2660,
      "ticks": 130,
      "text": "So I called. Something answered.",
      "style": "caption"
    },
    {
      "at": 2970,
      "ticks": 60,
      "text": "Not all of them are small.",
      "style": "caption"
    },
    {
      "at": 3190,
      "ticks": 120,
      "text": "AlchyForbidden",
      "style": "title",
      "color": "#6FE3D8"
    },
    {
      "at": 3215,
      "ticks": 95,
      "text": "The debt still stands.",
      "style": "subtitle"
    }
  ],
